# Copy to .env.local for local (non-docker) development.
# In docker-compose these are set as the `frontend` service's `environment:` instead.

# Must match the backend's SESSION_SECRET exactly — the frontend verifies
# session tokens locally (lib/auth.ts, middleware.ts) using this same secret,
# so it doesn't have to call the backend on every navigation.
SESSION_SECRET=dev-only-insecure-secret-change-me

BACKEND_URL=http://localhost:4000

# Google OAuth client ID (from console.cloud.google.com/apis/credentials).
# Public by design (NEXT_PUBLIC_ ships to the browser) — must match the
# backend's GOOGLE_CLIENT_ID exactly. Empty hides the Google sign-in button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Only used by the /api/test-db health route; the app itself reads the database
# through the backend.
MONGODB_URI=
