# Copy to .env — docker-compose auto-loads this and substitutes ${SESSION_SECRET}
# into both the frontend and backend service environments (docker-compose.yml).
# Generate a real one for anything beyond local dev: openssl rand -base64 32
SESSION_SECRET=dev-only-insecure-secret-change-me

# Google sign-in — the same OAuth Web client ID twice: the frontend bakes it into
# the page at build time, the backend checks tokens against it. The team's client ID is public (it is in every page's HTML); empty hides the
# Google button. Changing it needs `docker compose up -d --build`.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=322520901542-a8v0hplkahs4fbskcms0k64aj5qltb4g.apps.googleusercontent.com
GOOGLE_CLIENT_ID=322520901542-a8v0hplkahs4fbskcms0k64aj5qltb4g.apps.googleusercontent.com
