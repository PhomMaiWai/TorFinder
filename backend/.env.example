# Copy to .env for local development: cp .env.example .env
# Only per-deployment values live here. The portals' addresses, search keywords
# and per-request timeouts are code — see src/{egp,mea,datagov}/*.constants.ts.

# The database from `docker compose up -d db`. For a MongoDB of your own without
# auth, use mongodb://localhost:27017/torfinder instead.
MONGODB_URI=mongodb://torr:torr@localhost:27017/torfinder?authSource=admin
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Signs the session cookie. The frontend verifies it with the same value, so the
# two must match exactly or every logged-in request fails.
SESSION_SECRET=dev-only-insecure-secret-change-me

# Google sign-in. Must equal the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID —
# it is the audience the ID token is checked against. Empty disables it.
GOOGLE_CLIENT_ID=322520901542-a8v0hplkahs4fbskcms0k64aj5qltb4g.apps.googleusercontent.com

# Demo accounts on an empty database. Announcements always come from the portals.
SEED_DEMO_DATA=true

# Reading TOR documents with Vertex AI. An empty project id switches it off;
# credentials come from `gcloud auth application-default login`, never from here.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=asia-southeast1
VERTEX_MODEL=gemini-2.5-flash

# How often each background job runs, in minutes. 0 switches one off and leaves
# the admin button as the only way to run it. data.go.th republishes monthly, so
# polling it hourly would only re-read what it already handed over.
EGP_POLL_MINUTES=360
MEA_POLL_MINUTES=360
DATAGOV_POLL_MINUTES=1440
AI_POLL_MINUTES=60

# Whether a job also runs once at boot. Off locally on purpose: a dev server
# restarts all day, each import re-reads a whole portal, and each extraction run
# spends real model calls. Turn e-GP on for a deployment that starts empty.
EGP_POLL_ON_STARTUP=false
MEA_POLL_ON_STARTUP=false
DATAGOV_POLL_ON_STARTUP=false
AI_POLL_ON_STARTUP=false

# How deep into e-GP one import reaches: pages per announcement type, 50 results
# each. The portal holds thousands of projects and publishes newest first.
EGP_MAX_PAGES=2

# Requests allowed per minute: everything, then the login route on its own,
# which is the one worth brute-forcing.
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=5

# Notifications outside the app — each channel stays off while its key is empty.
# Email via Resend (https://resend.com → API Keys). Without a verified domain,
# Resend only delivers to your own address, from onboarding@resend.dev.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=TOR Finder <onboarding@resend.dev>
# LINE Messaging API: LINE Developers → your OA's channel → Messaging API → Channel access token (long-lived).
LINE_CHANNEL_ACCESS_TOKEN=
# Notify a company about a new TOR scoring at least this, at most this many per import.
NOTIFY_MATCH_THRESHOLD=70
NOTIFY_MAX_MATCHES_PER_RUN=5
