# Copy to .env.local for local (non-docker) development.
# In docker-compose these are set as the `frontend` service's `environment:` instead.

# Must match the backend's SESSION_SECRET exactly — the frontend verifies
# session tokens locally (lib/auth.ts, middleware.ts) using this same secret,
# so it doesn't have to call the backend on every navigation.
SESSION_SECRET=dev-only-insecure-secret-change-me
# During a rotation only (see the root .env.example):
# SESSION_SECRET_PREVIOUS=
# SESSION_SECRET_PREVIOUS_UNTIL=

# Minutes without activity before a session must sign in again (ASVS 7.3.1).
# Must be the same in backend and frontend. The absolute limit is 7 days.
# SESSION_IDLE_MINUTES=30

# Staff passkeys: must match the backend's value (required by default in production).
# STAFF_PASSKEYS_REQUIRED=false
# Company passkeys: must match the backend's value too.
# COMPANY_PASSKEYS_REQUIRED=false

BACKEND_URL=http://localhost:4000

# Google OAuth client ID (from console.cloud.google.com/apis/credentials).
# Public by design (NEXT_PUBLIC_ ships to the browser) — must match the
# backend's GOOGLE_CLIENT_ID exactly. Empty hides the Google sign-in button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=322520901542-a8v0hplkahs4fbskcms0k64aj5qltb4g.apps.googleusercontent.com
