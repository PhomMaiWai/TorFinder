# Copy to .env for local development: cp .env.example .env
# The e-GP portal URLs, search keywords and request timeouts are code — see
# src/egp/egp.constants.ts. Only per-deployment values live here.

MONGODB_URI=mongodb://torr:torr@localhost:27017/torr?authSource=admin
SESSION_SECRET=dev-only-insecure-secret-change-me
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Google OAuth client ID (from console.cloud.google.com/apis/credentials).
# Must match the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID exactly — it's the
# token audience Google sign-in is verified against. Empty disables it.
GOOGLE_CLIENT_ID=

# Demo accounts only; TOR records always come from e-GP.
SEED_DEMO_DATA=true

# Vertex AI (TOR PDF extraction). Empty project id leaves extraction off.
# Credentials come from Application Default Credentials — `gcloud auth
# application-default login` locally. Never put a key in this file.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=asia-southeast1
VERTEX_MODEL=gemini-2.5-flash

# Optional — defaults shown, uncomment to override.
#EGP_MAX_PAGES=2              # pages per announcement type, 50 results each
#EGP_CONCURRENCY=5            # requests in flight against the portal
#EGP_POLL_MINUTES=360         # 0 disables polling; admin button still works
#EGP_POLL_ON_STARTUP=true
#EGP_ENRICH_BUDGET_MS=45000   # cap on the detail phase; rest retried next sync
#THROTTLE_TTL_MS=60000
#THROTTLE_LIMIT=100
#AUTH_THROTTLE_TTL_MS=60000
#AUTH_THROTTLE_LIMIT=5
