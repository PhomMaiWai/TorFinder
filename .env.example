# Copy to .env — docker-compose auto-loads this and substitutes ${SESSION_SECRET}
# into both the frontend and backend service environments (docker-compose.yml).
# Required: the images run in production mode and refuse to start without a
# private value of 32+ characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=
# The day SESSION_SECRET was made; the backend logs config.secret_rotation_due
# once it is older than SESSION_SECRET_MAX_AGE_DAYS (default 365).
# SESSION_SECRET_CREATED=2026-11-20
# Rotating without signing everyone out: put the old value here and an end
# date at most 8 days ahead; both services accept it until then, then stop.
# SESSION_SECRET_PREVIOUS=
# SESSION_SECRET_PREVIOUS_UNTIL=2026-11-28

# Demo accounts (admin@bma.go.th etc. — passwords are in the README). Set to
# true only on your own machine; never on a server anyone else can reach.
SEED_DEMO_DATA=false

# Staff passkeys (admin, owner, auditor; docs/security/passkeys.md). Optional
# by default in docker compose (anyone who added one still has to use it).
# Set true on a real server so staff must add a passkey at first sign-in.
# Passkeys only work on the site's real address, so the backend's
# FRONTEND_ORIGIN must then be the public https:// origin.
# STAFF_PASSKEYS_REQUIRED=true
# Companies too (ASVS 6.3.3), on the same terms: set true on a real server.
# COMPANY_PASSKEYS_REQUIRED=true
# The site's public address as browsers see it (default http://localhost:3000).
# FRONTEND_ORIGIN=https://torfinder.example.go.th
# Minutes a passkey check counts for sensitive admin actions (step-up).
# STEP_UP_MINUTES=10

# Hours a request to grant or remove the admin role waits for a second admin before it lapses.
# ADMIN_APPROVAL_EXPIRY_HOURS=48

# Shortest time, in seconds, between a sign-up or comment form being served and sent (ASVS 2.4.2).
# FORM_MIN_SECONDS=2

# MongoDB root account. Leave the password unset: the first `docker compose up`
# generates it and keeps it in the torr_db_secrets volume (ASVS 13.2.3). Set it
# only to choose your own. Only read when the database volume is first created.
# To read the generated one (for mongosh or `npm run dev` against this database):
#   docker compose run --rm db-secrets cat /secrets/root-password
# MONGO_ROOT_USERNAME=torr
# MONGO_ROOT_PASSWORD=
# The backend has no database password: it signs in with its TLS certificate
# (MONGODB-X509, docs/operations/deployment-checklist.md "Internal TLS").

# Google sign-in — the same OAuth Web client ID twice: the frontend bakes it into
# the page at build time, the backend checks tokens against it. The team's client ID is public (it is in every page's HTML); empty hides the
# Google button. Changing it needs `docker compose up -d --build`.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=322520901542-a8v0hplkahs4fbskcms0k64aj5qltb4g.apps.googleusercontent.com
GOOGLE_CLIENT_ID=322520901542-a8v0hplkahs4fbskcms0k64aj5qltb4g.apps.googleusercontent.com

# Notifications outside the app — each channel stays off while its keys are empty.
# Email via Resend (https://resend.com → API Keys).
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=TOR Finder <onboarding@resend.dev>
# LINE: a LINE Official Account with the Messaging API on (see docs/operations/line-notifications.md).
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_BOT_ID=

# AI document reading (Vertex). Empty VERTEX_PROJECT_ID keeps it off.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=asia-southeast1
VERTEX_MODEL=gemini-2.5-flash
AI_POLL_MINUTES=60
AI_POLL_ON_STARTUP=false
# Absolute path to a service-account key (roles/aiplatform.user), kept OUTSIDE
# this repo, e.g. /Users/you/.config/torfinder/gcp-vertex.json
VERTEX_CREDENTIALS_FILE=
