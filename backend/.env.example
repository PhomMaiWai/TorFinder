# Copy to .env for local (non-docker) development: cp .env.example .env
# In docker-compose, these are set as service `environment:` instead.

# Required in production (backend/src/config/env.ts throws at boot if missing
# and NODE_ENV=production); dev-only defaults apply otherwise.
MONGODB_URI=mongodb://localhost:27017/torr
SESSION_SECRET=dev-only-insecure-secret-change-me

# Demo accounts and TOR records, inserted only when the collections are empty.
SEED_DEMO_DATA=true

PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# e-GP announcement feed (official RSS service, no API key needed).
# EGP_DEPARTMENTS is "deptId:ชื่อหน่วยงาน" pairs joined by "|" — the feed item has
# no agency name, so it comes from knowing which deptId was queried.
# Leave empty to pull the nationwide feed.
EGP_FEED_URL=https://process.gprocurement.go.th/EPROCRssFeedWeb/egpannouncerss.xml
EGP_DEPARTMENTS=
EGP_TIMEOUT_MS=20000

# Vertex AI (TOR PDF extraction). Empty project id leaves extraction off.
# Credentials come from Application Default Credentials — point
# GOOGLE_APPLICATION_CREDENTIALS at a service account key, or run `gcloud auth
# application-default login` locally. Never put a key in this file.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=asia-southeast1
VERTEX_MODEL=gemini-2.5-flash

# Rate limiting (ms / request count)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5
