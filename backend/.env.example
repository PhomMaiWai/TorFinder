# Copy to .env for local development: cp .env.example .env
# Only per-deployment values live here. The portals' addresses, search keywords
# and per-request timeouts are code — see src/{egp,mea,datagov}/*.constants.ts.

# The database from `docker compose up -d db` needs TLS with the dev client
# certificate (README, "Only the database in Docker?") and the generated root
# password: replace <root-password> with the output of
#   docker compose run --rm db-secrets cat /secrets/root-password
# (a volume made before that still uses `torr`). For a MongoDB of your own
# without auth, use mongodb://localhost:27017/torfinder instead.
MONGODB_URI="mongodb://torr:<root-password>@localhost:27017/torfinder?authSource=admin&tls=true&tlsCAFile=../docker/certs/dev/ca.crt&tlsCertificateKeyFile=../docker/certs/dev/local-dev.pem&directConnection=true"
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Signs the session cookie. The frontend verifies it with the same value, so the
# two must match exactly or every logged-in request fails.
SESSION_SECRET=dev-only-insecure-secret-change-me
# During a rotation only (see the root .env.example):
# SESSION_SECRET_PREVIOUS=
# SESSION_SECRET_PREVIOUS_UNTIL=
# The day SESSION_SECRET was made; config.secret_rotation_due is logged once it
# is older than SESSION_SECRET_MAX_AGE_DAYS.
# SESSION_SECRET_CREATED=2026-11-20
# SESSION_SECRET_MAX_AGE_DAYS=365

# Minutes without activity before a session must sign in again (ASVS 7.3.1).
# Must be the same in backend and frontend. The absolute limit is 7 days.
# SESSION_IDLE_MINUTES=30

# Staff passkeys (docs/security/passkeys.md). Default: required in production,
# optional here. Must be the same in backend and frontend. Passkeys are bound to
# FRONTEND_ORIGIN's host; WEBAUTHN_RP_ID overrides it (e.g. the parent domain).
# STAFF_PASSKEYS_REQUIRED=false
# Company passkeys (ASVS 6.3.3): the same default and the same rule.
# COMPANY_PASSKEYS_REQUIRED=false
# WEBAUTHN_RP_ID=localhost
# STEP_UP_MINUTES=10
# ADMIN_APPROVAL_EXPIRY_HOURS=48
# FORM_MIN_SECONDS=2

# Google sign-in. Must equal the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID —
# it is the audience the ID token is checked against. Empty disables it.
GOOGLE_CLIENT_ID=322520901542-a8v0hplkahs4fbskcms0k64aj5qltb4g.apps.googleusercontent.com

# Demo accounts on an empty database. Announcements always come from the portals.
SEED_DEMO_DATA=true
# Announcements published before this day are kept but not listed.
# TOR_LISTED_SINCE=2022-01-01

# Reading TOR documents with Vertex AI. An empty project id switches it off.
# Credentials are Application Default Credentials: either a service-account key
# with the Vertex AI User role (roles/aiplatform.user) on the project, kept
# OUTSIDE this repo and named below, or `gcloud auth application-default login`
# with GOOGLE_APPLICATION_CREDENTIALS left out. Never paste a key's contents here.
VERTEX_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.config/torfinder/gcp-vertex.json
VERTEX_LOCATION=asia-southeast1
VERTEX_MODEL=gemini-2.5-flash
# Embeds TORs for "find similar"; without a project id it ranks by shared keywords.
VERTEX_EMBEDDING_MODEL=text-multilingual-embedding-002

# How often each background job runs, in minutes. 0 switches one off and leaves
# the admin button as the only way to run it. data.go.th republishes monthly, so
# polling it hourly would only re-read what it already handed over.
EGP_POLL_MINUTES=360
MEA_POLL_MINUTES=360
DATAGOV_POLL_MINUTES=1440
# National e-GP: the procurement step of open announcements and follow-ups.
GPROC_POLL_MINUTES=180
AI_POLL_MINUTES=60

# Whether a job also runs once at boot. Off locally on purpose: a dev server
# restarts all day, each import re-reads a whole portal, and each extraction run
# spends real model calls. Turn e-GP on for a deployment that starts empty.
EGP_POLL_ON_STARTUP=false
MEA_POLL_ON_STARTUP=false
DATAGOV_POLL_ON_STARTUP=false
GPROC_POLL_ON_STARTUP=false
AI_POLL_ON_STARTUP=false

# Daily caps on Vertex AI calls that visitors can trigger (docs/SECURITY.md G1).
# Past the find-similar cap the search ranks by keywords; past a proposal cap
# the request is refused until midnight Bangkok time. 0 turns a cap off.
AI_PROPOSAL_DRAFTS_PER_ACCOUNT_PER_DAY=20
AI_PROPOSAL_DRAFTS_PER_DAY=300
AI_SIMILAR_EMBEDS_PER_DAY=2000

# Virus scanning of uploads and portal documents by a ClamAV daemon; off while
# CLAMAV_HOST is empty (docker-compose.hardening.yml runs one).
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=60000
# Refuse uploads when ClamAV (CLAMAV_HOST) is not set. Defaults to true when
# NODE_ENV=production, false otherwise (docs/SECURITY.md G6).
# VIRUS_SCAN_REQUIRED=

# How deep into e-GP one import reaches: pages per announcement type, 50 results
# each. The portal holds thousands of projects and publishes newest first.
EGP_MAX_PAGES=2
# How far back one import reads, requests in flight against the portal (lower it
# if the portal rate-limits), and the time cap on fetching each project's details.
# EGP_LOOKBACK_DAYS=120
# EGP_CONCURRENCY=5
# EGP_ENRICH_BUDGET_MS=45000

# Requests allowed per minute: everything, then the login route on its own,
# which is the one worth brute-forcing.
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=5
# The window both limits count over, in milliseconds.
# THROTTLE_TTL_MS=60000
# AUTH_THROTTLE_TTL_MS=60000
# Calls per minute per IP to the public LINE webhook.
# LINE_WEBHOOK_THROTTLE_LIMIT=300
# Failed logins per email address, from any IP, before it is locked for
# LOGIN_FAILURE_WINDOW_MS (15 minutes).
LOGIN_FAILURE_LIMIT=10
# LOGIN_FAILURE_WINDOW_MS=900000
# Hops allowed to name the client in X-Forwarded-For (the frontend). Default:
# loopback and private addresses only.
# TRUST_PROXY=loopback, uniquelocal

# Notifications outside the app — each channel stays off while its key is empty.
# Email via Resend (https://resend.com → API Keys). Without a verified domain,
# Resend only delivers to your own address, from onboarding@resend.dev.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=TOR Finder <onboarding@resend.dev>
# LINE Messaging API (setup: docs/operations/line-notifications.md). All three are needed.
# LINE Developers → your OA's channel → Messaging API → Channel access token (long-lived).
LINE_CHANNEL_ACCESS_TOKEN=
# Same channel → Basic settings → Channel secret. Checks the webhook really is LINE.
LINE_CHANNEL_SECRET=
# The OA's basic id, with the @ — LINE Official Account Manager → Settings.
LINE_BOT_ID=
# Notify a company about a new TOR scoring at least this, at most this many per import.
NOTIFY_MATCH_THRESHOLD=70
NOTIFY_MAX_MATCHES_PER_RUN=5

# Database connection limits and data retention; defaults and reasons in
# docs/operations/limits-and-retention.md. A retention period of 0 keeps that data forever.
# MONGO_MAX_POOL_SIZE=50
# MONGO_WAIT_QUEUE_TIMEOUT_MS=10000
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# RETENTION_NOTIFICATIONS_DAYS=180
# RETENTION_SYNC_RUNS_DAYS=90
# RETENTION_AUDIT_LOG_DAYS=365
# RETENTION_UNVERIFIED_SIGNUP_DAYS=30

# Mutual TLS between frontend and backend (docker-compose sets these). All three
# files or none; a local `npm run dev` leaves them out and serves plain HTTP.
# INTERNAL_TLS_CERT_FILE=
# INTERNAL_TLS_KEY_FILE=
# INTERNAL_TLS_CA_FILE=
# Certificate common names allowed to call the API.
# INTERNAL_TLS_ALLOWED_CLIENTS=frontend
